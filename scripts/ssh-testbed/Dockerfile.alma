# AlmaLinux 属于 RHEL 系；用于验证与 Debian 不同的 coreutils 版本和 sshd 默认设置。
FROM almalinux:9

RUN dnf install -y openssh-server shadow-utils \
 && dnf clean all \
 && mkdir -p /run/sshd \
 && useradd -m -s /bin/bash mred \
 && echo 'mred:mred' | chpasswd

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 22
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
